# Public site URL used for metadata, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=https://example.com

# Official contact details. Leave a value empty to hide that contact method.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Social profiles. Leave empty to hide.
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_X=

# Genie AI assistant (server-only — never prefix with NEXT_PUBLIC_).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: Gemini models to try in order (comma-separated).
GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest,gemini-3.1-flash-lite

# Firebase web config for saving enquiries and the /admin page.
# Firebase console → Project settings → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only — NEVER prefix with NEXT_PUBLIC_). Used by the portal
# to create/edit users. Firebase console → Project settings → Service accounts →
# Generate new private key. Provide ONE of:
#   FIREBASE_SERVICE_ACCOUNT        = the JSON file's full contents
#   FIREBASE_SERVICE_ACCOUNT_BASE64 = the JSON file, base64-encoded
FIREBASE_SERVICE_ACCOUNT=
